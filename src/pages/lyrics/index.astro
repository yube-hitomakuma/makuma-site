---
import { Image } from "astro:assets";
import weatherLandCover from "../../assets/weather-land.png";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Lyrics — Makuma">
  <main class="lyrics-index-page">


    <a class="back-link" href="/">← Home</a>

    <div class="lyrics-index-header">
      <p class="eyebrow">ARCHIVE</p>
      <h1>Lyrics</h1>
      <p class="lyrics-index-subtitle">
        
      </p>
    </div>

    <div class="lyrics-list">

      <a class="lyrics-item with-cover" href="/lyrics/inai">
        <img src="/covers/inai.png" alt="いない cover" />
        <div>
          <h2>いない</h2>
          <p>Single いない · 2020</p>
        </div>
        <span>→</span>
      </a>

      <a class="lyrics-item with-cover" href="/lyrics/tokyo-one-room">
        <img src="/covers/tokyo-one-room.png" alt="Tokyo one room cover" />
        <div>
          <h2>Tokyo One Room</h2>
          <p>Single Tokyo one room · 2020</p>
        </div>
        <span>→</span>
      </a>

      <a class="lyrics-item with-cover" href="/lyrics/nvm">
       <img src="/covers/nemurenai.png" alt="nemurenai cover" />

        <div>
          <h2>nvm</h2>
          <p>EP 眠れないぼくらは夜を泳ぐ · 2026</p>
        </div>
        <span>→</span>
      </a>

