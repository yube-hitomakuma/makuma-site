---
import { Image } from "astro:assets";
import weatherLandCover from "../../assets/weather-land.png";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Music — Makuma">
  <main class="music-page">

    <div class="music-header">
      <h1>Music</h1>
      <p>Discography</p>
    </div>

    <div class="music-grid">

      <a class="music-card" href="/Music/nemurenai">
        <img src="/covers/nemurenai.png" alt="nemurenai cover" />

        <div class="music-card-body">
          <h2>眠れないぼくらは夜を泳ぐ</h2>
          <p>EP · 2026</p>
        </div>
      </a>

      <a class="music-card" href="/Music/weatherland">
        <Image src={weatherLandCover} alt="Weather Land cover" width={640} format="webp" style="height:auto" />

        <div class="music-card-body">
          <h2>Weather Land</h2>
          <p>Album · 2025</p>
        </div>
      </a>

      <a class="music-card" href="/Music/inai">
        <img src="/covers/inai.png" alt="いない cover" />

        <div class="music-card-body">
          <h2>いない</h2>
          <p>Single · 2020</p>
        </div>
      </a>

      <a class="music-card" href="/Music/tokyo-one-room">
        <img src="/covers/tokyo-one-room.png" alt="Tokyo one room cover" />

        <div class="music-card-body">
          <h2>Tokyo one room</h2>
          <p>Single · 2020</p>
        </div>
      </a>

    </div>

  </main>
</BaseLayout>
