---
import { Image } from "astro:assets";
import weatherLandCover from "../../assets/weather-land.png";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Weather Land — Makuma">
  <main class="release-page">
    <a class="back-link" href="/Music">← Back to Music</a>

    <div class="release-hero">
      <Image class="release-cover" src={weatherLandCover} alt="Weather Land cover" width={960} format="webp" style="height:auto" />

      <div class="release-meta">
        <p class="eyebrow">ALBUM · 2025</p>
        <h1>Weather Land</h1>
        <p class="release-artist">マクマ · 2025.12.20 · 12 tracks</p>

        <div class="release-links">
          <a class="release-link" href="https://open.spotify.com/album/3gSwfYKT7gXo8JeQOLvqCU" target="_blank" rel="noopener noreferrer">Spotify</a>
          <a class="release-link" href="https://music.apple.com/jp/album/weather-land/1856903098" target="_blank" rel="noopener noreferrer">Apple Music</a>
        </div>
      </div>
    </div>

    <section class="tracklist">
      <h2>Tracklist</h2>
      <ol>
        <li>Intro</li>
        <li><a href="/lyrics/starsong">Starsong</a></li>
        <li><a href="/lyrics/braintrip">Braintrip</a></li>
        <li><a href="/lyrics/hope">Hope</a></li>
        <li><a href="/lyrics/aki-no-nagi">秋の凪</a></li>
        <li><a href="/lyrics/moonlight">ムーンライト</a></li>
        <li><a href="/lyrics/march">March</a></li>
        <li><a href="/lyrics/midnight-in-riverside">ミッドナイトインリバーサイド</a></li>
        <li><a href="/lyrics/52">52</a></li>
        <li><a href="/lyrics/garakuta-no-junreisha">ガラクタの巡礼者</a></li>
        <li><a href="/lyrics/violet">ヴァイオレット</a></li>
        <li><a href="/lyrics/weather-land">Weather Land</a></li>
      </ol>
    </section>

    <section class="release-player">
      <iframe
        title="Weather Land — Spotify player"
        style="border-radius:16px; border:0"
        src="https://open.spotify.com/embed/album/3gSwfYKT7gXo8JeQOLvqCU"
        width="100%"
        height="480"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </section>
  </main>
</BaseLayout>
