---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Tokyo one room — Makuma">
  <main class="release-page">
    <a class="back-link" href="/Music">← Back to Music</a>

    <div class="release-hero">
      <img
        class="release-cover"
        src="/covers/tokyo-one-room.png"
        alt="Tokyo one room cover"
      />

      <div class="release-meta">
        <p class="eyebrow">SINGLE · 2020</p>
        <h1>Tokyo one room</h1>
        <p class="release-artist">マクマ · 2020.09.27 · 1 track</p>

        <div class="release-links">
          <a class="release-link" href="https://open.spotify.com/album/52JvC9GU3gccZDG2lcw2VN" target="_blank" rel="noopener noreferrer">Spotify</a>
          <a
            class="release-link"
            href="https://music.apple.com/jp/song/1533084952"
            target="_blank"
            rel="noopener noreferrer"
          >
            Apple Music
          </a>
        </div>
      </div>
    </div>

    <section class="tracklist">
      <h2>Tracklist</h2>
      <ol>
        <li><a href="/lyrics/tokyo-one-room">Tokyo one room</a></li>
      </ol>
    </section>
    <section class="release-player">
      <iframe
        title="Tokyo one room — Spotify player"
        style="border-radius:16px; border:0"
        src="https://open.spotify.com/embed/album/52JvC9GU3gccZDG2lcw2VN"
        width="100%"
        height="352"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </section>
  </main>
</BaseLayout>
