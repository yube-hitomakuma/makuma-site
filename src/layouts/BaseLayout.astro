---
import "../styles/global.css";
const { title = "Makuma" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Zen+Old+Mincho:wght@400&display=swap" rel="stylesheet">
  <meta name="description" content="Makuma official lyrics archive. Music for sleepless nights." />
<meta property="og:title" content="Makuma" />
<meta property="og:description" content="Music for sleepless nights." />
<meta property="og:type" content="website" />

<meta property="og:image" content="https://makuma1005.com/ogp.jpg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://makuma1005.com/ogp.jpg" />
  </head>

 <body>
  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="site-logo">Makuma</a>
    </div>
  </header>

  <slot />
</body>
</html>